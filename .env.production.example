# Copy this file to .env on the server that runs docker-compose.prod.yml.
# Do not commit the real .env file.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_HOST=mysql
DB_PORT=3306
DB_NAME_PROD=businessmanager_prod
DB_USERNAME=businessmanager
DB_PASSWORD=replace-with-strong-db-password

# Frontend origins allowed to call the backend.
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# JWT
JWT_SECRET=replace-with-long-random-jwt-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Sensitive field encryption. Keep this stable and private.
APP_CRYPTO_SECRET=replace-with-strong-16-to-32-byte-secret

# Automated local backup
BACKUP_ENABLED=true
BACKUP_LOCATION=/opt/businessmanager/backups
BACKUP_CRON=0 0 2 * * ?
BACKUP_RETENTION_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_CRON=0 0 3 * * ?
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-backup-encryption-key

# Runtime tools inside the backend container
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
