# ==============================================================================
# BusinessManager Enterprise Backend Configuration Templates
# ==============================================================================

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=businessmanager_dev
DB_NAME_TEST=businessmanager_test
DB_NAME_PROD=businessmanager_prod
DB_USERNAME=root
DB_PASSWORD=password

# Spring profile and server
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Browser origins allowed to call this backend.
# Add your Firebase Hosting URL here after deployment, for example:
# APP_CORS_ALLOWED_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Security Secrets
# Use a secure 256-bit (32 bytes) hex-encoded key in production
JWT_SECRET=9a4f2c8d3b7a1e5f8g9h0i1j2k3l4m5n6o7p8q9r0s1t2u3v4w5x6y7z8a9b0c1d
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Print Subsystem Configuration (CUPS)
# Target address pointing to the company Ubuntu/Unix printing server
CUPS_SERVER_HOST=localhost
CUPS_SERVER_PORT=631

# Data encryption at rest for sensitive JPA fields.
# Use a strong secret and keep it outside backups.
APP_CRYPTO_SECRET=replace-with-strong-16-to-32-byte-secret

# Backup Subsystem Configuration (Google Drive API)
BACKUP_ENABLED=true
BACKUP_STAGING_DIRECTORY=./backups
BACKUP_CRON=0 0 2 * * ?
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-backup-encryption-key
BACKUP_GDRIVE_ENABLED=true
BACKUP_GDRIVE_CREDENTIALS_PATH=file:/opt/businessmanager/secrets/gdrive-service-account.json
BACKUP_GDRIVE_FOLDER_ID=google-drive-folder-id

# Optional external tool paths on Ubuntu host/container
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
